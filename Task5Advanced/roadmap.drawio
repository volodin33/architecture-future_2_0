<mxfile host="app.diagrams.net" type="device">
  <diagram id="roadmap" name="Roadmap Data Mesh">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Стратегический роадмап внедрения Data Mesh" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- Этапы (колонки) -->
        <mxCell id="s1" value="Этап 1. Пилот&#10;(0–6 мес)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="320" height="440" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Этап 2. Масштабирование&#10;(6–18 мес)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="390" y="80" width="320" height="440" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Этап 3. Поддержка доменов&#10;(18–36 мес)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="720" y="80" width="320" height="440" as="geometry" />
        </mxCell>

        <!-- Действия этап 1 -->
        <mxCell id="a1" value="• Пилот в 1–2 доменах (финрасчёты / пациентский поток)&#10;• Единые принципы событий, DLQ, Schema Registry&#10;• Первый дата-продукт + self-service BI MVP" style="text;html=1;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="75" y="130" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="• Расширение на критические домены&#10;• Потоковые витрины&#10;• ACL для интеграций через Camel и DWH" style="text;html=1;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="405" y="130" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="• Отказ от синхронных интеграций на критпути&#10;• Доменная аналитика на потоках&#10;• Вывод легаси (SQL Server, PowerBuilder)" style="text;html=1;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="735" y="130" width="290" height="120" as="geometry" />
        </mxCell>

        <!-- Роли -->
        <mxCell id="rolesT" value="Роли:" style="text;html=1;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="75" y="270" width="60" height="20" as="geometry" /></mxCell>
        <mxCell id="r1" value="Data Product Owner&#10;Data Engineer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="75" y="295" width="290" height="50" as="geometry" /></mxCell>
        <mxCell id="r2" value="+ BI-аналитик&#10;+ Platform Team" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="405" y="295" width="290" height="50" as="geometry" /></mxCell>
        <mxCell id="r3" value="+ Data Governance&#10;(владение, SLA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="735" y="295" width="290" height="50" as="geometry" /></mxCell>

        <!-- Бизнес-цели -->
        <mxCell id="goalsT" value="Бизнес-цель:" style="text;html=1;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="75" y="365" width="120" height="20" as="geometry" /></mxCell>
        <mxCell id="g1" value="Согласованная архитектура,&#10;границы доменов, MVP витрины" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="75" y="390" width="290" height="60" as="geometry" /></mxCell>
        <mxCell id="g2" value="Портал самообслуживания,&#10;работа доменов в новой модели" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="405" y="390" width="290" height="60" as="geometry" /></mxCell>
        <mxCell id="g3" value="Масштаб: новые продукты,&#10;регионы, данные почти в реальном времени" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="735" y="390" width="290" height="60" as="geometry" /></mxCell>

        <mxCell id="arrow" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="490" as="sourcePoint" /><mxPoint x="1040" y="490" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="arrowT" value="время →" style="text;html=1;align=left;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="970" y="495" width="80" height="20" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
