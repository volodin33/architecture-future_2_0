# Скопируйте в .env и при необходимости поменяйте значения.
# .env в .gitignore — реальные креды в репозиторий не попадают.

# Креды MinIO (root)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Те же креды для Terraform S3-backend (AWS SDK читает эти переменные)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Абсолютный путь к этой папке НА ХОСТЕ (для docker-out-of-docker bind-mount).
# POSIX-форма (/c/...) — Docker Desktop её принимает и нет проблем с backslash.
HOST_PROJECT_DIR=/c/MyProjects/Ydex/Sprint11/claude/architecture-future_2_0/Task2Advanced
